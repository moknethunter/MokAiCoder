GITHUB_TOKEN=
GITHUB_OWNER=moknethunter
GITHUB_REPO=MokAiCoder
GITHUB_BRANCH=main
# Optional exact browser origin, e.g. https://scanner.example.com
CORS_ORIGIN=
PUBLISH_ADDRESS=127.0.0.1
PUBLISH_PORT=8080

# Chat access token stays on the server. Generate a random value of at least 24 characters.
MOKAI_CHAT_TOKEN=
XAI_API_KEY=
# Optional comma-separated Grok model IDs. Leave empty to discover via xAI.
XAI_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=openrouter/free
# Point at the /v1/ API reachable FROM MokAiCoder. Leave empty to disable.
OLLAMA_BASE_URL=
# Optional paid provider. All three values are required to enable it.
PAID_AI_BASE_URL=
PAID_AI_API_KEY=
PAID_AI_MODELS=
PAID_AI_TOKEN_PARAMETER=max_completion_tokens

# Optional GitHub branch publishing credential, scoped to the configured repository.
MOKAI_GITHUB_WRITE_TOKEN=
# Optional dedicated local project directory. Mount it at this path if using Docker.
MOKAI_WORKSPACE_ROOT=
